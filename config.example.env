# Copy to config.env and adjust. Lines are KEY=VALUE; environment variables override this file.

# Users sign in with Toolkit accounts (the first run creates the administrator, from this computer only).
# This MultiProbe server is put into the server list on the first run; administrators add more on the
# "Servers" page, and every user connects to them with accounts of those servers.
MP_API_URL=http://localhost:40000
MAIN_SERVER_NAME=Main

# Time zone for users who have not picked one (and have not connected to a server yet)
DEFAULT_TIME_ZONE=UTC

# Where the report add-on listens
HOST=0.0.0.0
PORT=8090

# Log the user out after this many minutes without activity
SESSION_IDLE_MINUTES=480

# en or ru — used when the browser language is neither
DEFAULT_LANG=en

# CSV column separator: ; (what Excel expects in most European locales), comma, or tab
CSV_DELIMITER=;

# Problem time in the alarm report and the overview. Priorities: Log 0-99, Advisory 100-199,
# Caution 200-299, Warning 300-399, Error 400-499. Alarms at or above OUTAGE count as outage (Error),
# from DEGRADED up to OUTAGE as degradation (Warning + Caution); lower ones are not counted.
OUTAGE_MIN_PRIORITY=400
DEGRADED_MIN_PRIORITY=200

# Where report templates are stored (SQLite). Relative paths are taken from the current directory.
# DATA_DIR=C:\MultiProbeReports\data

# PDF: at most this many alarm rows are listed (the full list is always in CSV/XML)
PDF_MAX_ROWS=2000
