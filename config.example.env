# Copy to config.env and adjust. Lines are KEY=VALUE; environment variables override this file.

# MultiProbe API (central server)
MP_API_URL=http://localhost:40000

# Where the report add-on listens
HOST=0.0.0.0
PORT=8090

# Log the user out after this many minutes without activity
SESSION_IDLE_MINUTES=480

# en or ru — used when the browser language is neither
DEFAULT_LANG=en

# CSV column separator: ; (what Excel expects in most European locales), comma, or tab
CSV_DELIMITER=;

# Problem time in the alarm report. Priorities: Log 0-99, Advisory 100-199, Caution 200-299,
# Warning 300-399, Error 400-499. Alarms at or above OUTAGE count as outage (Warning + Error),
# from DEGRADED up to OUTAGE as degradation (Caution); lower ones are not counted.
OUTAGE_MIN_PRIORITY=300
DEGRADED_MIN_PRIORITY=200

# Where report templates are stored (SQLite). Relative paths are taken from the current directory.
# DATA_DIR=C:\MultiProbeReports\data

# PDF: at most this many alarm rows are listed (the full list is always in CSV/XML)
PDF_MAX_ROWS=2000
